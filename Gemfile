source "https://rubygems.org"

gem "jekyll", "~> 3.9"
gem "kramdown-parser-gfm"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-feed"
  gem "jekyll-paginate-v2"
end

# Windows/JRuby support, harmless to leave in on other platforms
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.2.0", :platforms => [:mingw, :x64_mingw, :mswin, :windows]

gem "liquid", "~> 4.0.4"
gem "webrick"
gem "csv"
gem "bigdecimal"
